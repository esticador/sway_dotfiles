# BEGIN_KITTY_THEME
# Catppuccin-Mocha
include current-theme.conf
# END_KITTY_THEME
#

# FONT CONFIGURATION
font_family CaskaydiaCove Nerd Font Mono
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 12

# BACKGROUND CONFIGURATION

background_opacity 0.5
dynamic_background_opacity yes
